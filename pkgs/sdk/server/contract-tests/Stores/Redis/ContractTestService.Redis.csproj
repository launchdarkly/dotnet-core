<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Redis integration of this repository, built from its sources against the local SDK for the contract test
       service. The integration's own project references the published SDK package. -->
  <PropertyGroup>
    <TestFramework Condition="'$(TESTFRAMEWORK)' == ''">net8.0</TestFramework>
    <TargetFrameworks>$(TESTFRAMEWORK)</TargetFrameworks>
    <AssemblyName>ContractTestService.Redis</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\..\dotnet-server-sdk-redis\src\**\*.cs" Exclude="..\..\..\..\..\dotnet-server-sdk-redis\src\AssemblyInfo.cs;..\..\..\..\..\dotnet-server-sdk-redis\src\bin\**;..\..\..\..\..\dotnet-server-sdk-redis\src\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\LaunchDarkly.ServerSdk.csproj" />
    <!-- The same version range as the integration's project. -->
    <PackageReference Include="StackExchange.Redis" Version="[2.0.513,]" />
  </ItemGroup>

</Project>
